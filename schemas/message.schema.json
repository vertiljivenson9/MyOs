{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "yOs Protocol Message",
  "type": "object",
  "required": ["source", "target", "action", "requestId"],
  "properties": {
    "source": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "requestId": {
      "type": "string"
    }
  }
}
