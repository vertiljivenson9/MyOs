{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "yOs Wallet",
  "type": "object",
  "required": ["ownerId", "balance", "transactions"],
  "properties": {
    "ownerId": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "minimum": 0
    },
    "transactions": {
      "type": "array",
      "items": {
        "$ref": "transaction.schema.json"
      }
    },
    "type": {
      "type": "string",
      "enum": ["user", "developer"]
    }
  }
}
